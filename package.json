{
  "name": "visitor-cci",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint",
    "typeorm": "tsx -r dotenv/config ./node_modules/typeorm/cli.js -d src/lib/db/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/lib/db/migrations/Migration",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "tsx -r dotenv/config scripts/seed.ts",
    "guide:video": "node --env-file=.env scripts/record-guide.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
